#!/bin/bash
set -euo pipefail

TARGET_VOLUME="${3:-/}"
TARGET_ROOT="${TARGET_VOLUME%/}"
APP="$TARGET_ROOT/Applications/HS Reconnect.app"
APP_BINARY="$APP/Contents/MacOS/HSReconnect"
WATCHER_BINARY="$APP/Contents/Library/LoginItems/HS Reconnect Watcher.app/Contents/MacOS/HSReconnectWatcher"
SOURCE_HELPER="$APP/Contents/Resources/hsreconnect-helper"
HELPER_DIR="$TARGET_ROOT/usr/local/libexec"
HELPER="$HELPER_DIR/hsreconnect-helper"
SUDOERS_DIR="$TARGET_ROOT/etc/sudoers.d"
SUDOERS="$SUDOERS_DIR/hsreconnect"
BUNDLE_ID="io.github.kulibabkaaa.HSReconnect"
LEGACY_APP="$TARGET_ROOT/Applications/Hearthstone Reconnect.app"
LEGACY_BINARY="$LEGACY_APP/Contents/MacOS/HearthstoneReconnect"
LEGACY_BUNDLE_ID="com.local.HearthstoneReconnect"
DESKTOP_SHORTCUT_NAME="HS Reconnect.app"

terminate_exact_executable() {
    local executable="$1"
    local process_name="$2"
    local pid command

    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        if [[ "$command" == "$executable" ||
            "$command" == "$executable"\ * ]]; then
            /bin/kill -TERM "$pid" 2>/dev/null || true
        fi
    done < <(/usr/bin/pgrep -x "$process_name" 2>/dev/null || true)

    for _ in $(/usr/bin/seq 1 50); do
        /bin/sleep 0.02
        if ! /usr/bin/pgrep -x "$process_name" >/dev/null 2>&1; then
            return
        fi
    done

    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        if [[ "$command" == "$executable" ||
            "$command" == "$executable"\ * ]]; then
            /bin/kill -KILL "$pid" 2>/dev/null || true
        fi
    done < <(/usr/bin/pgrep -x "$process_name" 2>/dev/null || true)
}

ensure_privileged_directory() {
    local directory="$1"
    local owner mode

    if [[ ! -e "$directory" && ! -L "$directory" ]]; then
        /bin/mkdir -p "$directory"
        /usr/sbin/chown root:wheel "$directory"
        /bin/chmod 755 "$directory"
    fi
    if [[ -L "$directory" || ! -d "$directory" ]]; then
        echo "The HS Reconnect installer found an unsafe system folder." >&2
        exit 1
    fi

    owner="$(/usr/bin/stat -f '%u' "$directory")"
    mode="$(/usr/bin/stat -f '%OLp' "$directory")"
    mode=$((8#$mode))
    if [[ "$owner" -ne 0 ]] || (( (mode & 0022) != 0 )); then
        echo "The HS Reconnect installer found an unsafe system folder." >&2
        exit 1
    fi
}

user_home_for() {
    local user="$1"
    local record user_home

    record="$(
        /usr/bin/dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null ||
            true
    )"
    user_home="${record#*: }"
    if [[ -z "$record" || "$user_home" != /* ||
        "$user_home" == "/" || "$user_home" == *$'\n'* ]]; then
        return 1
    fi
    printf '%s\n' "$user_home"
}

install_desktop_shortcut() {
    local user="$1"
    local user_home desktop_dir desktop_shortcut

    user_home="$(user_home_for "$user" || true)"
    [[ -n "$user_home" ]] || return 0
    desktop_dir="$user_home/Desktop"
    [[ -d "$desktop_dir" ]] || return 0
    desktop_shortcut="$desktop_dir/$DESKTOP_SHORTCUT_NAME"

    if ! /usr/bin/sudo -H -u "$user" \
        "$APP_BINARY" --create-desktop-shortcut "$desktop_shortcut"; then
        echo "HS Reconnect could not create its Desktop shortcut." >&2
    fi
}

console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ ! "$console_user" =~ ^[A-Za-z0-9._-]+$ ]] ||
    [[ "$console_user" == "root" ]] ||
    [[ "$console_user" == "loginwindow" ]] ||
    [[ "$console_user" == "_mbsetupuser" ]]; then
    echo "HS Reconnect requires a signed-in console user." >&2
    exit 1
fi

if [[ -L "$SOURCE_HELPER" || ! -f "$SOURCE_HELPER" ]]; then
    echo "The HS Reconnect helper is missing from the app." >&2
    exit 1
fi

/usr/bin/sudo -H -u "$console_user" \
    "$APP_BINARY" --unregister-login-item >/dev/null 2>&1 || true
terminate_exact_executable "$APP_BINARY" "HSReconnect"
terminate_exact_executable "$WATCHER_BINARY" "HSReconnectWatcher"
terminate_exact_executable "$LEGACY_BINARY" "HearthstoneReconnect"

ensure_privileged_directory "$HELPER_DIR"
ensure_privileged_directory "$SUDOERS_DIR"

helper_temp="$(/usr/bin/mktemp "$HELPER_DIR/.hsreconnect-helper.XXXXXX")"
sudoers_temp="$(/usr/bin/mktemp "$SUDOERS_DIR/.hsreconnect.XXXXXX")"

cleanup() {
    /bin/rm -f "$helper_temp" "$sudoers_temp"
}
trap cleanup EXIT

/usr/bin/install -o root -g wheel -m 755 "$SOURCE_HELPER" "$helper_temp"
helper_digest="$(
    /usr/bin/shasum -a 256 "$helper_temp" |
        /usr/bin/awk '{print $1}'
)"
if [[ ! "$helper_digest" =~ ^[a-f0-9]{64}$ ]]; then
    echo "The HS Reconnect helper could not be verified." >&2
    exit 1
fi
/bin/mv -f "$helper_temp" "$HELPER"

/usr/bin/printf '%s ALL=(root) NOPASSWD: sha256:%s %s\n' \
    "$console_user" "$helper_digest" \
    "/usr/local/libexec/hsreconnect-helper" \
    > "$sudoers_temp"
/usr/sbin/chown root:wheel "$sudoers_temp"
/bin/chmod 440 "$sudoers_temp"
/usr/sbin/visudo -cf "$sudoers_temp" >/dev/null
/bin/mv -f "$sudoers_temp" "$SUDOERS"

/bin/rm -rf "$LEGACY_APP"
/usr/bin/sudo -H -u "$console_user" \
    /usr/bin/defaults delete "$LEGACY_BUNDLE_ID" >/dev/null 2>&1 || true

/usr/bin/sudo -H -u "$console_user" \
    /usr/bin/defaults delete "$BUNDLE_ID" >/dev/null 2>&1 || true

install_desktop_shortcut "$console_user"

exit 0
